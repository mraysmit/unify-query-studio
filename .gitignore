# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
application-local.properties
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Logs and test reports outside target/
# ---------------------------------------------------------------------------
*.log
logs/

# ---------------------------------------------------------------------------
# IDEs
# ---------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# Eclipse / VS Code Java language server
.classpath
.project
.settings/
.factorypath
bin/
.apt_generated/
.apt_generated_tests/

# VS Code: personal settings stay local; shared recommendations may be committed
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ---------------------------------------------------------------------------
