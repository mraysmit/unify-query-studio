<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.unify.querystudio</groupId>
    <artifactId>query-studio-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>qs-design</artifactId>
  <name>Query Studio :: Design</name>
  <description>Maps the Access-style design view to canonical Calcite SQL and back: criteria cells, join graph, grid.</description>

  <dependencies>
    <dependency>
      <groupId>org.apache.calcite</groupId>
      <artifactId>calcite-core</artifactId>
    </dependency>
    <!-- End-to-end design tests: design -> canonical SQL -> compile -> run on SQLite. -->
    <dependency>
      <groupId>com.unify.querystudio</groupId>
      <artifactId>qs-compiler</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.unify.querystudio</groupId>
      <artifactId>qs-catalog</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.unify.querystudio</groupId>
      <artifactId>qs-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
