  "queries": [
    {
      "name":"Completed orders",
      "tables":[{"name":"Customers","x":48,"y":48},{"name":"Orders","x":410,"y":48}],
      "joins":[{"fromTable":"Customers","fromField":"customer_id","toTable":"Orders","toField":"customer_id","type":"INNER"}],
      "columns":[
        {"table":"Customers","field":"name","alias":"customer","show":true},
        {"table":"Customers","field":"city","show":true},
        {"table":"Orders","field":"order_date","show":true,"sort":"DESC"},
        {"table":"Orders","field":"total","show":true,"criteria":">= 100"},
        {"table":"Orders","field":"status","show":true,"criteria":"= 'Completed'"}
      ]
    },
    {
      "name":"Sales by country",
      "totals":true,
      "tables":[{"name":"Customers","x":48,"y":48},{"name":"Orders","x":410,"y":48}],
      "joins":[{"fromTable":"Customers","fromField":"customer_id","toTable":"Orders","toField":"customer_id","type":"INNER"}],
      "columns":[
        {"table":"Customers","field":"country","show":true},
        {"table":"Orders","field":"order_id","alias":"orders","aggregate":"COUNT","show":true},
        {"table":"Orders","field":"total","alias":"revenue","aggregate":"SUM","show":true,"sort":"DESC"}
      ]
    },
    {
      "name":"Customers without orders",
      "tables":[{"name":"Customers","x":48,"y":48},{"name":"Orders","x":410,"y":48}],
      "joins":[{"fromTable":"Customers","fromField":"customer_id","toTable":"Orders","toField":"customer_id","type":"LEFT"}],
      "columns":[
        {"table":"Customers","field":"name","show":true},
        {"table":"Customers","field":"country","show":true},
        {"table":"Orders","field":"order_id","show":false,"criteria":"IS NULL"}
      ]
    }
  ]
