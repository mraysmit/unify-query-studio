<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.unify.querystudio</groupId>
  <artifactId>query-studio-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Query Studio</name>
  <description>Access-style visual query designer; Apache Calcite generates SQL for the target database. See docs/technical-design.md.</description>

  <modules>
    <module>learning-tests</module>
    <module>qs-testkit</module>
    <module>qs-dialects</module>
    <module>qs-catalog</module>
    <module>qs-compiler</module>
    <module>qs-design</module>
    <module>qs-execution</module>
    <module>qs-server</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <calcite.version>1.42.0</calcite.version>
    <sqlite-jdbc.version>3.54.1.0</sqlite-jdbc.version>
    <jackson.version>2.21.9</jackson.version>
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <quarkus.version>4.0.1</quarkus.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Keeps every Jackson module on one version; Calcite brings an older jackson-annotations. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.calcite</groupId>
        <artifactId>calcite-core</artifactId>
        <version>${calcite.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite-jdbc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>com.unify.querystudio</groupId>
        <artifactId>qs-testkit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.unify.querystudio</groupId>
        <artifactId>qs-dialects</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.unify.querystudio</groupId>
        <artifactId>qs-catalog</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.unify.querystudio</groupId>
        <artifactId>qs-compiler</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.unify.querystudio</groupId>
        <artifactId>qs-design</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.unify.querystudio</groupId>
        <artifactId>qs-execution</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.3</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Builds and tests run on Java 25, the version the product targets. -->
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>java-25</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,26)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
